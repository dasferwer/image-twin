            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CollectionInput"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          }
        },
